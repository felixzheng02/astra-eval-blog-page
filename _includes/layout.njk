<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set authorNames = site.authors | authorNames %}
  <meta name="title" content="{{ site.title }}{% if authorNames %} - {{ authorNames }}{% endif %}">
  {% if site.description %}
  <meta name="description" content="{{ site.description }}">
  {% endif %}
  {% if site.keywords and site.keywords.length %}
  <meta name="keywords" content="{{ site.keywords | join(', ') }}">
  {% endif %}
  <meta name="author" content="{{ authorNames }}">
  <meta name="robots" content="index, follow">
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ site.title }}">
  {% if site.description %}
  <meta property="og:description" content="{{ site.description }}">
  {% endif %}
  {% if site.url %}
  <meta property="og:url" content="{{ site.url }}">
  {% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ site.title }}">
  <title>{{ site.title }}{% if authorNames %} - {{ authorNames }}{% endif %}</title>
  <link rel="icon" type="image/x-icon" href="{{ '/static/images/favicon.ico' | url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="{{ '/static/css/bulma.min.css' | url }}">
  <link rel="stylesheet" href="{{ '/static/css/bulma-carousel.min.css' | url }}">
  <link rel="stylesheet" href="{{ '/static/css/bulma-slider.min.css' | url }}">
  <link rel="stylesheet" href="{{ '/static/css/fontawesome.all.min.css' | url }}">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/jpswalsh/academicons@1/css/academicons.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.19.0/dist/katex.min.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="{{ '/static/css/index.css' | url }}">
  <link rel="stylesheet" href="{{ '/static/css/writeup.css' | url }}">
  <script defer src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
  <script defer src="{{ '/static/js/fontawesome.all.min.js' | url }}"></script>
  <script defer src="{{ '/static/js/bulma-carousel.min.js' | url }}"></script>
  <script defer src="{{ '/static/js/bulma-slider.min.js' | url }}"></script>
  <script defer src="{{ '/static/js/index.js' | url }}"></script>
</head>
<body class="has-navbar-fixed-top">
  <nav class="navbar is-white is-fixed-top writeup-nav" role="navigation" aria-label="section navigation">
    <div class="container">
      <div class="navbar-brand">
        <a class="navbar-item" href="{{ '/' | url }}">{{ site.title }}</a>
        <a role="button" class="navbar-burger" data-target="writeupNavMenu" aria-label="menu" aria-expanded="false">
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </a>
      </div>
      <div id="writeupNavMenu" class="navbar-menu">
        <div class="navbar-end">
          {% for section in collections.sections %}
          {% set subs = section | sectionSubheadings %}
          {% if subs | length %}
          <div class="navbar-item has-dropdown is-hoverable">
            <a class="navbar-link" href="#{{ section.data.nav | slug }}" aria-haspopup="true">{{ section.data.nav }}</a>
            <div class="navbar-dropdown" role="menu">
              {% for sub in subs %}
              <a class="navbar-item" href="#{{ sub.id }}" role="menuitem">{{ sub.title }}</a>
              {% endfor %}
            </div>
          </div>
          {% else %}
          <a class="navbar-item" href="#{{ section.data.nav | slug }}">{{ section.data.nav }}</a>
          {% endif %}
          {% endfor %}
          {% if site.bibtex %}
          <a class="navbar-item" href="#citation">Citation</a>
          {% endif %}
        </div>
      </div>
    </div>
  </nav>

  <section class="hero publication-header">
    <div class="hero-body">
      <div class="container is-max-desktop">
        <div class="columns is-centered">
          <div class="column has-text-centered">
            <h1 class="title is-1 publication-title">
              {% if site.title_html %}{{ site.title_html | safe }}{% else %}{{ site.title }}{% endif %}
            </h1>
            <div class="is-size-5 publication-authors">
              {% for author in site.authors %}
              <span class="author-block">
                {% if author.url %}
                <a href="{{ author.url }}">{{ author.name }}</a>{% else %}{{ author.name }}{% endif %}{% if author.equal %}<sup>*</sup>{% endif %}{% if author.corresponding %}<sup>†</sup>{% endif %}{% if not loop.last %},{% endif %}
              </span>
              {% endfor %}
            </div>
            {% if site.affiliation or site.venue %}
            <div class="is-size-5 publication-authors">
              {% if site.affiliation %}<span class="author-block">{{ site.affiliation }}</span>{% endif %}
              {% if site.venue %}<span class="publication-venue">{{ site.venue }}</span>{% endif %}
            </div>
            {% endif %}
            {% if site.equal_contribution or site.corresponding %}
            <div class="is-size-6 eql-cntrb">
              {% if site.equal_contribution %}<sup>*</sup>{{ site.equal_contribution }}{% endif %}
              {% if site.equal_contribution and site.corresponding %} · {% endif %}
              {% if site.corresponding %}<sup>†</sup>{{ site.corresponding }}{% endif %}
            </div>
            {% endif %}
            {% set hasLinks = site.links.paper or site.links.arxiv or site.links.code or site.links.supplementary %}
            {% if hasLinks %}
            <div class="hero-links">
              {% if site.links.paper %}
              <span class="link-block">
                <a href="{{ site.links.paper }}" class="external-link button is-normal is-rounded is-dark">
                  <span class="icon"><i class="fas fa-file-pdf"></i></span>
                  <span>Paper</span>
                </a>
              </span>
              {% endif %}
              {% if site.links.arxiv %}
              <span class="link-block">
                <a href="{{ site.links.arxiv }}" class="external-link button is-normal is-rounded is-dark">
                  <span class="icon"><i class="ai ai-arxiv"></i></span>
                  <span>arXiv</span>
                </a>
              </span>
              {% endif %}
              {% if site.links.code %}
              <span class="link-block">
                <a href="{{ site.links.code }}" class="external-link button is-normal is-rounded is-dark">
                  <span class="icon"><i class="fab fa-github"></i></span>
                  <span>Code</span>
                </a>
              </span>
              {% endif %}
              {% if site.links.supplementary %}
              <span class="link-block">
                <a href="{{ site.links.supplementary }}" class="external-link button is-normal is-rounded is-dark">
                  <span class="icon"><i class="fas fa-file"></i></span>
                  <span>Supplementary</span>
                </a>
              </span>
              {% endif %}
            </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </section>

  {{ content | safe }}

  {% if site.bibtex %}
  <section class="section" id="citation">
    <div class="container is-max-desktop">
      <div class="columns is-centered">
        <div class="column is-full">
          <h2 class="title is-3 has-text-centered">Citation</h2>
          <div class="bibtex-header">
            <div></div>
            <button class="copy-bibtex-btn" type="button" onclick="copyBibTeX()">
              <span class="copy-text">Copy</span>
            </button>
          </div>
          <pre><code id="bibtex-code">{{ site.bibtex }}</code></pre>
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  <footer class="footer">
    <div class="container">
      <div class="columns is-centered">
        <div class="column is-8">
          <div class="content has-text-centered">
            <p>
              This page was built using the
              <a href="https://github.com/eliahuhorwitz/Academic-project-page-template" target="_blank" rel="noopener">Academic Project Page Template</a>,
              adopted from the <a href="https://nerfies.github.io" target="_blank" rel="noopener">Nerfies</a> project page.
              You are free to borrow the source code of this website; please keep this attribution.
              This website is licensed under a
              <a rel="license" href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">Creative Commons Attribution-ShareAlike 4.0 International License</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </footer>

  <button class="scroll-to-top" type="button" onclick="scrollToTop()" aria-label="Scroll to top">
    <i class="fas fa-arrow-up"></i>
  </button>
</body>
</html>
