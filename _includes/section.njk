{% set sectionContent = section.templateContent %}
{% set sectionId = section | fallbackSectionId %}
<section class="section"{% if sectionId %} id="{{ sectionId }}"{% endif %}>
  <div class="container is-max-desktop">
    <div class="columns is-centered">
      <div class="column is-full">
        <div class="content publication-body">
          {{ sectionContent | safe }}
        </div>
      </div>
    </div>
  </div>
</section>
