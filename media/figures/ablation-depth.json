tyleHighlight(key) {\n    var indices = [];\n    var sizes = [];\n    var opacities = [];\n    var textColors = [];\n    var textIdx = [];\n    var id = key && key.id;\n    var condition = key && key.condition;\n    gd.data.forEach(function(trace, i) {\n        var kind = kindOf(trace);\n        if (kind !== 'trial' && kind !== 'average') return;\n        indices.push(i);\n        var traceCond = trace.meta && trace.meta.condition;\n        var otherCondition = !!(condition && traceCond && traceCond !== condition);\n        if (kind === 'trial') {\n            var trials = trace.meta.trials || [];\n            var sz = [], op = [];\n            for (var j = 0; j \u003c trials.length; j++) {\n                if (key == null) {\n                    sz.push(CFG.trialSize);\n                    op.push(CFG.trialOpacity);\n                } else if (!otherCondition && id !== 'average'\n                           && Number(trials[j]) === Number(id)) {\n                    sz.push(CFG.trialHiSize);\n                    op.push(CFG.trialHiOpacity);\n                } else {\n                    sz.push(CFG.trialSize);\n                    op.push(CFG.dimOpacity);\n                }\n            }\n            sizes.push(sz);\n            opacities.push(op);\n        } else {\n            var hi = !!(key && id === 'average' && !otherCondition);\n            var on = (key == null || hi);\n            sizes.push([hi ? CFG.meanHiSize : CFG.meanSize]);\n            opacities.push([on ? 1 : CFG.dimOpacity]);\n            textIdx.push(i);\n            textColors.push(on ? (trace.meta.label_color || '#263342')\n                               : 'rgba(38,51,66,0.22)');\n        }\n    });\n    if (!indices.length) return Promise.resolve();\n    return Plotly.restyle(gd, {'marker.size': sizes, 'marker.opacity': opacities}, indices)\n        .then(function() {\n            if (!textIdx.length) return;\n            return Plotly.restyle(gd, {'textfont.color': textColors}, textIdx);\n        });\n}\n\nfunction highlight(key) {\n    if (sameKey(key, current)) return;\n    current = key;\n    chain = chain.then(function() {\n        if (!sameKey(key, current)) return;\n        return restyleHighlight(current);\n    });\n}\n\nfunction keyFromEvent(ev) {\n    if (!ev || !ev.points || !ev.points.length) return null;\n    var pt = ev.points[0];\n    var trace = gd.data[pt.curveNumber];\n    var kind = kindOf(trace);\n    var condition = trace && trace.meta && trace.meta.condition;\n    if (kind === 'average') return {id: 'average', condition: condition};\n    if (kind === 'trial') {\n        var trial = ((trace.meta && trace.meta.trials) || [])[pt.pointNumber];\n        if (trial == null) return null;\n        return {id: String(trial), condition: condition};\n    }\n    return null;\n}\n\nvar unhoverTimer = null;\ngd.on('plotly_hover', function(ev) {\n    if (unhoverTimer) { clearTimeout(unhoverTimer); unhoverTimer = null; }\n    var key = keyFromEvent(ev);\n    if (key != null) highlight(key);\n});\ngd.on('plotly_unhover', function() {\n    unhoverTimer = setTimeout(function() {\n        unhoverTimer = null;\n        highlight(null);\n    }, 80);\n});\n"}}}}